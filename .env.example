# Copy this file to .env and use your actual MySQL connection details.
# MySQL 8.4+ is supported by the installed Django 6.1.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=atelier_pc
MYSQL_USER=atelier_pc
MYSQL_PASSWORD=CHANGE_ME

# For hosted MySQL, use the host/port/user supplied by your provider.
# Optional: absolute path to the provider's CA certificate (TLS verification).
# MYSQL_SSL_CA=C:/path/to/ca.pem

DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# DJANGO_SECRET_KEY=your-private-key
