# Copy this file to .env and use your actual MySQL connection details.
# MySQL 8.4+ is supported by the installed Django 6.1.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=atelier_pc
MYSQL_USER=atelier_pc
MYSQL_PASSWORD=CHANGE_ME

# For hosted MySQL, use the host/port/user supplied by your provider.
# Optional: absolute path to the provider's CA certificate (TLS verification).
# MYSQL_SSL_CA=C:/path/to/ca.pem

DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Optional private upload directory; default: the project's media/ folder.
# DJANGO_MEDIA_ROOT=C:/private/techcare-media
# DJANGO_SECRET_KEY=your-private-key

# Browser alerts: generate the keys with `python manage.py setup_webpush`.
# The private key belongs in .private/ (excluded from Git).
# WEBPUSH_PRIVATE_KEY=C:/path/to/project/.private/webpush-private.pem
# WEBPUSH_PUBLIC_KEY=generated-public-key
# WEBPUSH_SUBJECT=https://github.com/amenyRahmeni/TechCARE
